<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduMation</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="site-nav">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo.png" alt="EduMation" />
                <span>Learn with a clear path.</span>
            </a>
            <button class="nav-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Toggle navigation">Menu</button>
            <div class="collapse nav-links" id="mainNav">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Learn" asp-action="Index">Learn</a>
                <a asp-controller="Learn" asp-action="Curriculum">Curriculum</a>
                <a asp-controller="Learn" asp-action="Practice">Practice</a>
                <a asp-controller="Ai" asp-action="Chat">Ask AI</a>
                <a asp-controller="Videos" asp-action="Index">Explore</a>
                <form class="nav-search" asp-controller="Search" asp-action="Index" method="get">
                    <input type="search" name="query" placeholder="Search lessons" aria-label="Search lessons" />
                    <button type="submit" aria-label="Search">Go</button>
                </form>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="WatchHistory" asp-action="Index">My Learning</a>
                    <a asp-controller="Learn" asp-action="Progress">Progress</a>
                    <a asp-controller="Favorites" asp-action="MyFavorites">Saved</a>
                    <a asp-controller="Subscription" asp-action="Index">Subscription</a>
                    <a asp-controller="Profile" asp-action="Index">Me</a>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="nav-action" type="submit">Log out</button>
                    </form>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin" asp-action="Index">Admin</a>
                        <a asp-controller="Curriculum" asp-action="Index">NCTB Import</a>
                        <a asp-controller="UserRoles" asp-action="Index">User Roles</a>
                    }
                }
                else
                {
                    <a class="nav-quiet" asp-controller="Account" asp-action="Login">Log in</a>
                    <a class="nav-cta" asp-controller="Account" asp-action="Register">Start learning</a>
                }
            </div>
        </nav>
    </header>
    <div class="site-shell">
        <main role="main" class="pb-3">
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success">@TempData["Message"]</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="site-footer-inner">
            <strong>EduMation</strong>
            <span>Learn it here. Practice it on Protijog.</span>
            <span>&copy; @DateTime.Now.Year EduMation</span>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
