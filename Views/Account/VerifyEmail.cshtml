@model EduMation.ViewModels.VerifyEmailViewModel
@{ ViewData["Title"] = "Verify email"; }
<section class="auth-shell"><div class="auth-card">
    <p class="eyebrow">One more step</p><h1>Verify your email</h1>
    <p>Enter the six-digit code we emailed you. Codes expire after 15 minutes.</p>
    <form asp-action="VerifyEmail" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input asp-for="UserId" type="hidden" />
        <label asp-for="Code"></label><input asp-for="Code" class="form-control" inputmode="numeric" autocomplete="one-time-code" maxlength="6" />
        <span asp-validation-for="Code" class="text-danger"></span>
        <button class="button button-primary" type="submit">Verify account</button>
    </form>
    <form asp-action="ResendVerification" method="post" class="mt-3">
        <input name="Email" type="hidden" value="@Model.Email" />
        <button class="button button-outline" type="submit">Send a new code</button>
    </form>
</div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
