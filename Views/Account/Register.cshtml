@model EduMation.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create account";
}

<section class="auth-shell">
    <div class="auth-visual">
        <div class="auth-orbit"></div>
        <p class="eyebrow">Your next chapter</p>
        <h1>Build a habit of understanding.</h1>
        <p>Create one EduMation identity for learning, practice, progress, and the future Protijog connection.</p>
    </div>
    <div class="auth-card">
        <p class="eyebrow">Start learning</p>
        <h2>Create account</h2>
        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group"><label asp-for="FullName"></label><input asp-for="FullName" class="form-control" autocomplete="name" /><span asp-validation-for="FullName" class="text-danger"></span></div>
            <div class="form-group"><label asp-for="UserId"></label><input asp-for="UserId" class="form-control" autocomplete="username" /><span asp-validation-for="UserId" class="text-danger"></span></div>
            <div class="form-group"><label asp-for="Email"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="text-danger"></span></div>
            <div class="form-group"><label asp-for="LearningClassId">Your class</label><select asp-for="LearningClassId" class="form-control"><option value="">Choose your class</option>@foreach (var item in (IEnumerable<EduMation.Models.LearningClass>)(ViewBag.LearningClasses ?? Array.Empty<EduMation.Models.LearningClass>())) { <option value="@item.Id">@item.Name</option> }</select><span asp-validation-for="LearningClassId" class="text-danger"></span></div>
            <div class="form-group"><label asp-for="District"></label><input asp-for="District" class="form-control" autocomplete="address-level2" /><span asp-validation-for="District" class="text-danger"></span></div>
            <div class="form-group"><label asp-for="ContactNumber"></label><input asp-for="ContactNumber" class="form-control" autocomplete="tel" /><span asp-validation-for="ContactNumber" class="text-danger"></span></div>
            <div class="form-group"><label asp-for="Password"></label><input asp-for="Password" class="form-control" type="password" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger"></span><label class="form-check-label"><input type="checkbox" class="toggle-password" /> Show password</label></div>
            <div class="form-group"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
            <button type="submit" class="button button-primary">Create account</button>
            <a class="button button-outline google-signin" asp-action="GoogleLogin">Continue with Google</a>
            <p class="auth-help">Already learning here? <a asp-action="Login">Log in</a></p>
        </form>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
