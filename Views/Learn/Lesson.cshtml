@model EduMation.ViewModel.LessonDetailsViewModel
@{
    ViewData["Title"] = Model.Lesson.Title;
    var topic = Model.Lesson.Topic;
    var chapter = topic.Chapter;
    var subject = chapter.Subject;
    var learningClass = subject.LearningClass;
}

<section class="lesson-header">
    <p class="eyebrow"><a asp-action="Subject" asp-route-classSlug="@learningClass.Slug" asp-route-subjectSlug="@subject.Slug">@learningClass.Name / @subject.Name</a> / @chapter.Title / @topic.Title</p>
    <h1>@Model.Lesson.Title</h1>
    <p>@Model.Lesson.Description</p>
</section>

<div class="lesson-layout">
    <main>
        @if (Model.Lesson.Video != null && !string.IsNullOrWhiteSpace(Model.Lesson.Video.VideoUrl))
        {
            <div class="lesson-player">
                <video class="lesson-video" controls preload="metadata" poster="@Model.Lesson.Video.ThumbnailUrl" data-progress-url="@Url.Action("TrackLessonProgress", "Learn", new { id = Model.Lesson.Id })" data-resume-position="@Model.ResumePositionSeconds">
                    <source src="@Model.Lesson.Video.VideoUrl" />
                </video>
            </div>
        }
        else
        {
            <div class="lesson-placeholder"><span>Lesson animation / video</span><strong>Media will appear here.</strong></div>
        }
        <div class="lesson-body">
            @if (!string.IsNullOrWhiteSpace(Model.Lesson.Summary))
            {
                <div><p class="eyebrow">Lesson summary</p><p>@Model.Lesson.Summary</p></div>
            }
            <div>
                <p class="eyebrow">What you will learn</p>
                <ul class="objective-list">
                    @foreach (var objective in Model.Lesson.LearningObjectives.Split(';', StringSplitOptions.RemoveEmptyEntries))
                    {
                        <li>@objective.Trim()</li>
                    }
                </ul>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Lesson.KeyConcepts))
            {
                <div><p class="eyebrow">Key concepts</p><ul class="objective-list">@foreach (var concept in Model.Lesson.KeyConcepts.Split(';', StringSplitOptions.RemoveEmptyEntries)){<li>@concept.Trim()</li>}</ul></div>
            }
            <div class="progress-panel">
                <span>Your progress</span>
                <strong>@Model.ProgressPercent%</strong>
                <div class="progress-track"><span style="width: @Model.ProgressPercent%"></span></div>
            </div>
        </div>
    </main>
    <aside class="lesson-sidebar">
        <h2>Ready to practice?</h2>
        <p>Use a quick EduMation practice set, then review anything that needs another look.</p>
        <a class="button button-primary button-full" asp-action="LessonPractice" asp-route-id="@Model.Lesson.Id">AI practice</a>
        <a class="button button-outline button-full" asp-controller="Ai" asp-action="Chat" asp-route-lessonId="@Model.Lesson.Id">Ask AI about this lesson</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form asp-controller="Favorites" asp-action="@(Model.IsSaved ? "RemoveLesson" : "AddLesson")" method="post">
                <input type="hidden" name="lessonId" value="@Model.Lesson.Id" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                <button class="button button-outline button-full" type="submit">@(Model.IsSaved ? "Saved · remove" : "Save lesson")</button>
            </form>
        }
        @if (User.Identity?.IsAuthenticated == true)
        {
            @Html.AntiForgeryToken()
            <form asp-action="CompleteLesson" asp-route-id="@Model.Lesson.Id" method="post">
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                <button class="button button-dark button-full" type="submit" data-lesson-complete="@(Model.Lesson.VideoId.HasValue ? "video" : "manual")" disabled="@(Model.Lesson.VideoId.HasValue && !Model.IsCompleted)">@(Model.IsCompleted ? "Completed" : Model.Lesson.VideoId.HasValue ? "Watch to 90% to complete" : "Mark complete")</button>
            </form>
        }
    </aside>
</div>

<section class="practice-moment" data-practice-moment hidden>
    <div class="practice-moment-icon">&#129504;</div>
    <div>
        <p class="eyebrow">Lesson complete</p>
        <h2>Ready to see what you understood?</h2>
        <p>Try a short, curriculum-aware practice set before you move on.</p>
    </div>
    <a class="button button-primary" asp-action="LessonPractice" asp-route-id="@Model.Lesson.Id">Start AI practice</a>
</section>

@if (Model.RelatedLessons.Count > 0)
{
    <section class="content-section"><div class="section-heading"><div><p class="eyebrow">Keep exploring</p><h2>Related lessons</h2></div></div><div class="lesson-grid">
        @foreach (var related in Model.RelatedLessons)
        {
            <article class="lesson-card"><h3>@related.Title</h3><p>@related.Description</p><a class="text-link" asp-action="Lesson" asp-route-id="@related.Id">Open lesson →</a></article>
        }
    </div></section>
}
