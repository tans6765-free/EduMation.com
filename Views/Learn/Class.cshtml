@model EduMation.Models.LearningClass
@{
    ViewData["Title"] = Model.Name;
}

<section class="page-hero compact-hero">
    <div>
        <p class="eyebrow"><a asp-action="Index">Learn</a> / Class</p>
        <h1>@Model.Name</h1>
        <p class="hero-copy">Choose a subject and continue through its chapters, topics, lessons, and AI practice.</p>
    </div>
    <a class="button button-outline" asp-controller="Ai" asp-action="Chat">Ask EduMation AI</a>
</section>

<section class="content-section">
    <div class="subject-grid">
        @foreach (var subject in Model.Subjects.OrderBy(item => item.DisplayOrder))
        {
            <a class="subject-card" asp-action="Subject" asp-route-classSlug="@Model.Slug" asp-route-subjectSlug="@subject.Slug">
                <span class="subject-index">@(subject.DisplayOrder.ToString("00"))</span>
                <h2>@subject.Name</h2>
                <p>@subject.Chapters.Count chapter(s)</p>
                <span class="text-link">View subject &rarr;</span>
            </a>
        }
    </div>
    @if (!Model.Subjects.Any())
    {
        <div class="empty-state">
            <p class="eyebrow">Curriculum import ready</p>
            <h2>This class is ready for its NCTB subjects.</h2>
            <p>When you provide the official book data, each subject, chapter, topic, lesson, and AI practice path will appear here.</p>
        </div>
    }
</section>
