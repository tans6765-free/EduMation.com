@{
    ViewData["Title"] = "Practice";
}

<section class="page-hero">
    <div>
        <p class="eyebrow">Learn, then test yourself</p>
        <h1>Practice belongs beside every lesson.</h1>
        <p class="hero-copy">Start with a quick EduMation check. When Protijog is ready, its Edumation section will open the deeper practice set for the same topic.</p>
    </div>
</section>

<section class="practice-grid content-section">
    <article class="practice-card practice-primary">
        <span class="practice-label">Available now</span>
        <h2>Quick practice</h2>
        <p>Short checks will give immediate feedback without taking you away from the lesson flow.</p>
        <a class="button button-primary" href="#coming-soon">Explore practice</a>
    </article>
    <article class="practice-card">
        <span class="practice-label">Protijog integration</span>
        <h2>Practice on Protijog</h2>
        <p>The future Protijog Edumation section will contain topic practice, deeper quizzes, and exam challenges for EduMation learners.</p>
        <a class="button button-outline" href="#coming-soon">Protijog coming soon</a>
    </article>
</section>
