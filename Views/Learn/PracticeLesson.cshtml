@model EduMation.ViewModel.PracticeViewModel
@{
    ViewData["Title"] = "AI Practice - " + Model.Lesson.Title;
}

<section class="practice-hero">
    <div>
        <p class="eyebrow">AI Practice Moment</p>
        <h1>Let's see what you understood.</h1>
        <p class="hero-copy">A short check for <strong>@Model.Lesson.Title</strong>. Answer one question at a time and learn from every result.</p>
    </div>
    <span class="practice-counter" data-practice-counter>@(Model.Questions.Count > 0 ? $"Question 1 of {Model.Questions.Count}" : "Practice unavailable")</span>
</section>

@Html.AntiForgeryToken()
<section class="question-stage" data-practice data-session-id="@Model.PracticeSessionId" data-lesson-id="@Model.Lesson.Id" data-question-count="@Model.Questions.Count">
    @if (Model.Questions.Count == 0)
    {
        <article class="empty-state"><h2>Practice questions could not be created</h2><p>Check that this lesson has a summary, description, or key concepts and that the server has a Gemini API key configured. Ask an admin to review the AI configuration if practice still does not load.</p><a class="button button-outline" asp-controller="Learn" asp-action="Lesson" asp-route-id="@Model.Lesson.Id">Return to lesson</a></article>
    }
    @for (var index = 0; index < Model.Questions.Count; index++)
    {
        var question = Model.Questions[index];
        <article class="question-card @(index == 0 ? "is-active" : "")" data-question>
            <p class="eyebrow">Question @(index + 1) · @question.QuestionType · @question.MaximumMarks mark@(question.MaximumMarks == 1 ? "" : "s")</p>
            <h2>@question.Prompt</h2>
            @if (EduMation.ViewModel.PracticeQuestionViewModel.IsChoiceType(question.QuestionType))
            {
                <div class="answer-options">
                    @for (var optionIndex = 0; optionIndex < question.Options.Length; optionIndex++) { <button type="button" class="answer-option" data-answer="@optionIndex">@question.Options[optionIndex]</button> }
                </div>
            }
            else { <textarea class="written-answer" data-written-answer rows="@(question.MaximumMarks == 5 ? 7 : 3)" maxlength="4000" placeholder="Write what you understand…"></textarea><button class="button button-primary" type="button" data-submit-written>Check my answer</button> }
            <div class="answer-feedback" data-feedback hidden></div>
            <button class="button button-primary question-next" type="button" data-next hidden>Next question</button>
        </article>
    }
    <article class="practice-result" data-practice-result hidden>
        <div class="mastery-burst" aria-hidden="true">&#10024;</div>
        <p class="eyebrow">Mastery check complete</p>
        <h2>You scored <strong data-score>0</strong>/<span data-maximum>@Model.Questions.Sum(item => item.MaximumMarks)</span> marks</h2>
        <p data-result-message>Every answer helps build your understanding.</p>
        <a class="button button-primary" asp-controller="Learn" asp-action="Lesson" asp-route-id="@Model.Lesson.Id">Review lesson</a>
    </article>
</section>
