@model EduMation.ViewModel.SitePageViewModel
@{ ViewData["Title"] = Model.Id == 0 ? "Create Page" : "Edit Page"; }
<section class="content-section"><p class="eyebrow">Site content CMS</p><h1>@ViewData["Title"]</h1>
<form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" asp-route-id="@(Model.Id == 0 ? null : Model.Id)" method="post" class="curriculum-edit-form">
    @Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <label asp-for="Title">Page title</label><input asp-for="Title" maxlength="160" required />
    <label asp-for="Slug">URL slug</label><input asp-for="Slug" maxlength="80" placeholder="about-our-team" required /><span asp-validation-for="Slug" class="text-danger"></span>
    <label asp-for="MetaDescription">SEO description</label><textarea asp-for="MetaDescription" rows="2" maxlength="240" required></textarea>
    <label asp-for="Body">Page text</label><textarea asp-for="Body" rows="16" maxlength="30000" required></textarea><p>Text is displayed as plain text with line breaks. HTML is escaped for safety.</p>
    <label class="check-label"><input asp-for="IsPublished" /> Published</label><button class="button button-primary" type="submit">Save page</button>
</form></section>
