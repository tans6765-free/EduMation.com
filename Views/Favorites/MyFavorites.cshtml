@model EduMation.ViewModel.SavedItemsViewModel
@{ ViewData["Title"] = "Saved Learning"; }
<section class="page-hero compact-hero"><div><p class="eyebrow">Your learning library</p><h1>Saved</h1><p class="hero-copy">Lessons and videos you want to return to.</p></div></section>
<section class="content-section">
    @if (Model.Lessons.Count == 0 && Model.Videos.Count == 0) { <div class="empty-state"><h2>Your saved list is ready</h2><p>Save lessons and videos as you explore.</p></div> }
    <div class="lesson-grid">
        @foreach (var saved in Model.Lessons)
        {
            <article class="lesson-card"><div class="lesson-card-top"><span class="lesson-chip">@saved.Lesson.Topic.Chapter.Subject.LearningClass.Name · @saved.Lesson.Topic.Chapter.Subject.Name</span><span>@saved.Lesson.DurationMinutes min</span></div><h2>@saved.Lesson.Title</h2><p>@saved.Lesson.Description</p><div class="d-flex gap-2"><a class="button button-primary" asp-controller="Learn" asp-action="Lesson" asp-route-id="@saved.LessonId">Continue</a><form asp-action="RemoveLesson" method="post"><input type="hidden" name="lessonId" value="@saved.LessonId"/><button class="button button-outline" type="submit">Remove saved</button></form></div></article>
        }
        @foreach (var video in Model.Videos)
        {
            <article class="lesson-card"><h2>@video.Title</h2><p>@video.Description</p><div class="d-flex gap-2"><a class="button button-primary" asp-controller="Videos" asp-action="Details" asp-route-id="@video.Id">Watch</a><form asp-action="Remove" method="post"><input type="hidden" name="videoId" value="@video.Id"/><button class="button button-outline" type="submit">Remove saved</button></form></div></article>
        }
    </div>
</section>
