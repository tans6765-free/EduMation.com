@model EduMation.ViewModel.HomeLandingViewModel
@{
    ViewData["Title"] = "Learn. Practice. Master.";
}

<section class="home-hero">
    <div class="hero-content">
        <p class="eyebrow">A clearer way to learn the NCTB curriculum</p>
        <h1>Learn.<br /><em>Practice.</em><br />Master.</h1>
        <p class="hero-copy">EduMation turns complex ideas into engaging lessons, useful practice, and progress you can see.</p>
        <div class="hero-actions">
            <a class="button button-primary" asp-controller="Learn" asp-action="Index">Start learning</a>
            <a class="button button-outline" asp-controller="Learn" asp-action="Index">Explore curriculum</a>
        </div>
    </div>
    <div class="hero-notes" aria-hidden="true">
        <span class="note note-one">x + y</span>
        <span class="note note-two">A = &pi;r&sup2;</span>
        <span class="note note-three">01</span>
        <span class="note note-four">learn</span>
    </div>
</section>

<section class="content-section home-section">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Your starting point</p>
            <h2>What are you learning today?</h2>
        </div>
        <a class="text-link" asp-controller="Learn" asp-action="Index">View all classes &rarr;</a>
    </div>
    <div class="class-grid">
        @foreach (var learningClass in Model.Classes)
        {
            <a class="class-tile" asp-controller="Learn" asp-action="Class" asp-route-classSlug="@learningClass.Slug">
                <span class="class-number">@learningClass.Name.Replace("Class ", "")</span>
                <span class="class-name">@learningClass.Name</span>
                <span class="class-meta">@learningClass.Subjects.Count subjects</span>
                <span class="tile-arrow">Explore &rarr;</span>
            </a>
        }
    </div>
</section>

<section class="process-band">
    <div class="section-heading">
        <div>
            <p class="eyebrow">The EduMation loop</p>
            <h2>Learning that keeps moving.</h2>
        </div>
    </div>
    <div class="process-grid">
        <div><span>01</span><h3>Learn</h3><p>Watch and understand the idea.</p></div>
        <div><span>02</span><h3>Practice</h3><p>Check what stayed with you.</p></div>
        <div><span>03</span><h3>Assess</h3><p>Measure your understanding.</p></div>
        <div><span>04</span><h3>Improve</h3><p>Return to the places that need work.</p></div>
    </div>
</section>

<section class="content-section home-section">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Start small</p>
            <h2>Featured lessons</h2>
        </div>
        <a class="text-link" asp-controller="Learn" asp-action="Index">See the learning hub &rarr;</a>
    </div>
    <div class="lesson-grid">
        @foreach (var lesson in Model.FeaturedLessons)
        {
            <article class="lesson-card">
                <div class="lesson-card-top"><span class="lesson-chip">@lesson.Topic.Chapter.Title</span><span>@lesson.DurationMinutes min</span></div>
                <h3>@lesson.Title</h3>
                <p>@lesson.Description</p>
                <a class="text-link" asp-controller="Learn" asp-action="Lesson" asp-route-id="@lesson.Id">Open lesson &rarr;</a>
            </article>
        }
    </div>
</section>

<section class="protijog-band">
    <div>
        <p class="eyebrow">Coming next</p>
        <h2>Learn it on EduMation.<br /><em>Practice it on Protijog.</em></h2>
        <p>When Protijog is ready, its EduMation section will connect each lesson to deeper problem solving, quizzes, and exams.</p>
    </div>
    <a class="button button-light" href="/protijog-coming-soon">Explore Protijog</a>
</section>
