@model EduMation.Models.Profile
@{
    ViewData["Title"] = "My Profile";
    var classes = ViewBag.LearningClasses as IEnumerable<EduMation.Models.LearningClass> ?? Array.Empty<EduMation.Models.LearningClass>();
    var isComplete = (int)(ViewBag.ProfileCompletion ?? 0) == 100;
    var isEditing = (bool)(ViewBag.IsEditing ?? false);
    var badges = ViewBag.Achievements as IEnumerable<EduMation.Models.StudentAchievement> ?? Array.Empty<EduMation.Models.StudentAchievement>();
}

<section class="page-hero compact-hero profile-hero">
    <div>
        <p class="eyebrow">Your student dashboard</p>
        <h1>Welcome, @(string.IsNullOrWhiteSpace(Model.FullName) ? "Student" : Model.FullName)</h1>
        <p class="hero-copy">Your progress, achievements, saved learning, calendar, and account details are all here.</p>
    </div>
    <div class="progress-stat"><strong>@ViewBag.ProgressPercent%</strong><span>learning progress</span></div>
</section>

<section class="content-section profile-content">
    <div class="profile-completion-card lesson-card">
        <div class="profile-completion-copy">
            <p class="eyebrow">@(isComplete ? "Profile badge earned" : "Your next profile step")</p>
            <h2>@ViewBag.ProfileCompletion% complete</h2>
            <p>@(isComplete ? "Your profile is complete. Your badge is in achievements." : $"Next: {ViewBag.NextStep}. Finish the steps to earn your profile badge.")</p>
        </div>
        <div class="profile-completion-meter" role="progressbar" aria-label="Profile completion" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@ViewBag.ProfileCompletion">
            <span class="progress-track"><span style="width:@ViewBag.ProfileCompletion%"></span></span>
            <strong>@ViewBag.ProfileCompletion%</strong>
        </div>
    </div>

    <div class="profile-dashboard-links">
        <a class="lesson-card" asp-controller="Learn" asp-action="Progress"><strong>Progress</strong><span>@ViewBag.CompletedLessons / @ViewBag.TotalLessons lessons complete</span></a>
        <a class="lesson-card" asp-controller="Calendar" asp-action="Index"><strong>Calendar</strong><span>Exams, study plans, and reminders</span></a>
        <a class="lesson-card" asp-controller="WatchHistory" asp-action="Index"><strong>Watch history</strong><span>Continue recent lessons and videos</span></a>
        <a class="lesson-card" asp-controller="Favorites" asp-action="MyFavorites"><strong>Saved lessons</strong><span>Your favorites and bookmarks</span></a>
        <a class="lesson-card" asp-controller="Subscription" asp-action="Index"><strong>Subscription details</strong><span>View your current plan information</span></a>
    </div>
</section>

<section class="content-section profile-settings">
    <div class="lesson-card profile-summary">
        <div class="profile-identity">
            <img src="@(Model.ProfilePicturePath ?? "/images/default-profile.png")" alt="Profile picture" class="profile-picture" />
            <div class="profile-identity-copy">
                <p class="eyebrow">Student account</p>
                <h2>@(string.IsNullOrWhiteSpace(Model.FullName) ? "Your profile" : Model.FullName)</h2>
                <p>@Model.Email</p>
                <span class="profile-verified @(ViewBag.EmailVerified ? "is-verified" : "")">@(ViewBag.EmailVerified ? "Email verified" : "Email not verified")</span>
            </div>
        </div>
        <dl class="profile-details">
            <div><dt>Class</dt><dd>@(Model.LearningClass?.Name ?? "Not selected")</dd></div>
            <div><dt>District</dt><dd>@(string.IsNullOrWhiteSpace(Model.District) ? "Not added" : Model.District)</dd></div>
            <div><dt>Contact</dt><dd>@(string.IsNullOrWhiteSpace(Model.ContactNumber) ? "Not added" : Model.ContactNumber)</dd></div>
        </dl>

        @if (Model.LearningClass is not null)
        {
            <a class="button button-primary profile-curriculum-button" asp-controller="Learn" asp-action="Class" asp-route-classSlug="@Model.LearningClass.Slug">Open my class curriculum <span aria-hidden="true">→</span></a>
        }

        <div class="profile-badges">
            <h3>Badges earned</h3>
            @if (!badges.Any())
            {
                <p>Complete your profile and keep learning to earn your first badge.</p>
            }
            else
            {
                <div class="achievement-list">
                    @foreach (var badge in badges)
                    {
                        <span class="achievement-badge">@badge.Icon @badge.Title</span>
                    }
                </div>
            }
        </div>

        @if (!isEditing && isComplete)
        {
            <a class="button button-outline profile-edit-button" asp-action="Index" asp-route-edit="true">Edit profile</a>
        }
        else if (!isEditing)
        {
            <div class="profile-next-step">
                <span class="profile-step-icon" aria-hidden="true">✦</span>
                <div>
                    <p class="eyebrow">Next step</p>
                    <h3>@ViewBag.NextStep</h3>
                    <p>@(ViewBag.NeedsEmailVerification ? "Verify your email to continue setting up your learning profile." : "Add the next detail to unlock your profile badge and class learning path.")</p>
                </div>
                @if ((bool)(ViewBag.NeedsEmailVerification ?? false))
                {
                    <a class="button button-primary" asp-controller="Account" asp-action="VerifyEmail" asp-route-userId="@Model.UserId">Verify email</a>
                }
                else
                {
                    <a class="button button-primary" asp-action="Index" asp-route-edit="true">Continue profile setup</a>
                }
            </div>
        }
    </div>

    @if (isEditing)
    {
        <form asp-action="Edit" method="post" enctype="multipart/form-data" class="lesson-card profile-form">
            <div class="profile-form-heading"><div><p class="eyebrow">Account details</p><h2>Edit your profile</h2><p>Only your name and district are required here. Other details can be added whenever you like.</p></div><a class="text-link" asp-action="Index">Cancel</a></div>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="Id" type="hidden" />
            <input asp-for="UserId" type="hidden" />
            <input asp-for="Email" type="hidden" />
            <input asp-for="ProfilePicturePath" type="hidden" />
            <div class="profile-form-grid">
                <div class="profile-field profile-field-wide"><label asp-for="FullName"></label><input asp-for="FullName" autocomplete="name" maxlength="120" /><span asp-validation-for="FullName" class="text-danger"></span></div>
                <div class="profile-field"><label asp-for="District"></label><input asp-for="District" autocomplete="address-level2" maxlength="80" /><span asp-validation-for="District" class="text-danger"></span></div>
                <div class="profile-field"><label asp-for="ContactNumber">Contact number <span>(optional)</span></label><input asp-for="ContactNumber" autocomplete="tel" maxlength="40" /><span asp-validation-for="ContactNumber" class="text-danger"></span></div>
                <div class="profile-field"><label asp-for="Age">Age <span>(optional)</span></label><input asp-for="Age" type="number" min="8" max="120" /><span asp-validation-for="Age" class="text-danger"></span></div>
                <div class="profile-field"><label asp-for="LearningClassId">Class</label><select asp-for="LearningClassId"><option value="">Choose a class</option>@foreach (var item in classes){<option value="@item.Id">@item.Name</option>}</select><span asp-validation-for="LearningClassId" class="text-danger"></span></div>
                <div class="profile-field profile-field-wide"><label asp-for="Address">Address <span>(optional)</span></label><input asp-for="Address" autocomplete="street-address" maxlength="300" /><span asp-validation-for="Address" class="text-danger"></span></div>
                <div class="profile-field"><label asp-for="PreferredLanguage">Preferred language</label><select asp-for="PreferredLanguage"><option value="en">English</option><option value="bn">বাংলা</option></select></div>
                <div class="profile-field profile-field-wide"><label asp-for="LearningPreferences">Learning preferences <span>(optional)</span></label><textarea asp-for="LearningPreferences" rows="3" maxlength="1000" placeholder="Topics or study preferences"></textarea><span asp-validation-for="LearningPreferences" class="text-danger"></span></div>
                <div class="profile-field profile-field-wide"><label for="profilePicture">Profile picture <span>(optional, up to 5 MB)</span></label><input id="profilePicture" type="file" name="profilePicture" accept=".jpg,.jpeg,.png,.webp,.gif" /></div>
            </div>
            <div class="profile-form-actions"><button class="button button-primary" type="submit">Save changes</button><a class="button button-outline" asp-action="Index">Cancel</a></div>
        </form>
    }
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
