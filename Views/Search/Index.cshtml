@model EduMation.ViewModel.SearchViewModel
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Query) ? "Search lessons" : $"Search: {Model.Query}";
}
<section class="content-section">
    <p class="eyebrow">Explore EduMation</p>
    <h1>Search lessons and learning resources</h1>
    <form asp-controller="Search" asp-action="Index" method="get" class="search-page-form">
        <label for="query">What do you want to learn?</label>
        <input id="query" name="query" value="@Model.Query" type="search" placeholder="Try Class 5 fractions" />
        <button class="button button-primary" type="submit">Search</button>
    </form>
    @if (!string.IsNullOrWhiteSpace(Model.Query))
    {
        <section class="content-section">
            <h2>Lessons (@Model.Lessons.Count)</h2>
            @if (Model.Lessons.Count == 0) { <p>No curriculum lessons matched. Try a class, subject, chapter, or topic.</p> }
            <div class="lesson-grid">
                @foreach (var lesson in Model.Lessons)
                {
                    var subject = lesson.Topic.Chapter.Subject;
                    <article class="lesson-card">
                        <div class="lesson-card-top"><span class="lesson-chip">@subject.LearningClass.Name · @subject.Name</span></div>
                        <p class="section-note">@lesson.Topic.Chapter.Title · @lesson.Topic.Title</p>
                        <h3>@lesson.Title</h3>
                        <p>@lesson.Description</p>
                        <a class="text-link" asp-controller="Learn" asp-action="Lesson" asp-route-id="@lesson.Id">Open lesson →</a>
                    </article>
                }
            </div>
        </section>
        @if (Model.Videos.Count > 0)
        {
            <section class="content-section">
                <h2>Videos (@Model.Videos.Count)</h2>
                <div class="lesson-grid">
                    @foreach (var video in Model.Videos)
                    {
                        <article class="lesson-card"><h3>@video.Title</h3><p>@video.Description</p><a class="text-link" asp-controller="Videos" asp-action="Details" asp-route-id="@video.Id">Watch video →</a></article>
                    }
                </div>
            </section>
        }
    }
</section>
